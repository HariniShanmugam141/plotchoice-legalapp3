# Court Case Search POC - example environment file
# Copy this to ".env" and adjust as needed. No secrets are required for
# this POC since it drives a visible, human-in-the-loop browser session
# (manual CAPTCHA entry) rather than calling any authenticated API.

# Flask
FLASK_ENV=development
FLASK_PORT=5000

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOWMO_MS=200

# Session
SESSION_TTL_SECONDS=300
